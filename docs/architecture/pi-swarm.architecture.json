  "cards": [
    {
      "dot": "cyan",
      "title": "协调模型",
      "items": [
        "无监督 LLM,代理之间零直接调用",
        "任务池是持久工作源,事件只是通知",
        "收到事件不等于获得任务所有权"
      ]
    },
    {
      "dot": "emerald",
      "title": "扩展运行时",
      "items": [
        "每个会话一个扩展实例,双循环独立运行",
        "任务池循环只发现工作,认领由 LLM 决定",
        "唤醒调度批量投递收件箱,空闲才触发回合"
      ]
    },
    {
      "dot": "rose",
      "title": "文件原生与恢复",
      "items": [
        "YAML / Markdown / JSONL 即全部状态,零外部服务",
        "单机原子文件原语解决认领竞争",
        "心跳过期且进程确认死亡才自动恢复"
      ]
    }
  ]
